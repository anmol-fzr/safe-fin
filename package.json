{
	"name": "safefin",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "turbo run build",
		"build:admin": "turbo run build -F @safe-fin/admin",
		"build:docs": "turbo run build -F @safe-fin/docs",
		"dev": "turbo run dev",
		"test": "turbo run test -F @safe-fin/server",
		"check": "biome check",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "turbo format",
		"check-types": "turbo run check-types",
		"deps:check": "syncpack list-mismatches",
		"deps:fix": "syncpack fix-mismatches",
		"deps:update": "syncpack update",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"husky": "^9.1.7",
		"syncpack": "^13.0.4",
		"turbo": "^2.5.6",
		"typescript": "5.9.2",
		"wrangler": "^4.40.3"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.10",
			"@better-auth/epo": "1.4.20",
			"react": "19.2.0",
			"react-dom": "19.2.0",
			"react-native": "0.83.2",
			"better-auth": "1.4.20",
			"@cloudflare/workers-types": "^4.20260114.0"
		},
		"onlyBuiltDependencies": [
			"@shopify/react-native-skia"
		]
	}
}
