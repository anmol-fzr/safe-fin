{
	"name": "safefin",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"husky": "^9.1.7",
		"syncpack": "^13.0.4",
		"turbo": "^2.5.6",
		"typescript": "5.9.2",
		"wrangler": "^4.40.3"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.3",
	"private": true,
	"overrides": {
		"@types/react": "19.1.10",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.81.5"
	},
	"catalog": {
		"@types/react": "19.1.10",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.81.5"
	},
	"scripts": {
		"build": "turbo run build",
		"build:admin": "turbo run build -F @safe-fin/admin",
		"build:docs": "turbo run build -F @safe-fin/docs",
		"dev": "turbo run dev",
		"test": "turbo run test -F @safe-fin/server",
		"check": "biome check",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "turbo format",
		"check-types": "turbo run check-types",
		"deps:check": "syncpack list-mismatches",
		"deps:fix": "syncpack fix-mismatches",
		"deps:update": "syncpack update",
		"auth:generate": "turbo run auth:generate --filter=@safe-fin/auth",
		"prepare": "husky",
		"build:android:preview": "turbo run build:android:preview -F @safe-fin/app"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
