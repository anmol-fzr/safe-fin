{
	"cli": {
		"version": ">= 3.15.1"
	},
	"build": {
		"production": {
			"bun": "1.3.5",
			"channel": "production",
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"APP_VARIANT": "production"
			}
		},
		"development": {
			"extends": "production",
			"distribution": "internal",
			"channel": "development",
			"developmentClient": true,
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"preview": {
			"extends": "production",
			"distribution": "internal",
			"channel": "preview",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"APP_VARIANT": "preview"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
