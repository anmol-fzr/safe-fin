	"engines": {
		"node": "^22.19.0"
	},
	"packageManager": "pnpm@10.24.0",
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"enabled": true,
				"exclude": [
					"@safe-fin/ui",
					"@safe-fin/auth"
				],
				"listUnknownPackages": false
			}
		}
	},
	"reanimated": {
		"staticFeatureFlags": {
			"ENABLE_SHARED_ELEMENT_TRANSITIONS": true
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@shopify/react-native-skia"
		]
	}
