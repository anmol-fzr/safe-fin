{
	"root": false,
	"extends": "//",
	"linter": {
		"includes": ["src/**/*", "!./src/routeTree.gen.ts"],
		"domains": {
			"react": "recommended",
			"test": "recommended"
		},
		"rules": {
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useSemanticElements": "off",
				"useAriaPropsForRole": "off"
			}
		}
	},
	"formatter": {
		"includes": ["src/**/*", "!./src/routeTree.gen.ts"]
	}
}
