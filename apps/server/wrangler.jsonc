{
  "name": "safe-fin",
  "main": "./src/index.ts",
  "compatibility_date": "2022-07-12",
  "compatibility_flags": [
    "export_commonjs_default",
    "nodejs_compat"
  ],
  "preview_urls": true,
  "dev": {
    "ip": "192.168.29.195",
    "port": 3000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2e03d7a48e124a6992fce8146dcbf91c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safe-fin-dev",
      "database_id": "123"
    }
  ],
  "env": {
    "prod": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "safe-fin-dev",
          "database_id": "f3511c33-e483-466f-b16e-428487152f19"
        }
      ]
    }
  }
}
