{
	"name": "@safe-fin/server",
	"type": "module",
	"scripts": {
		"cf:typegen": "wrangler types --env-interface CloudflareBindings",
		"deploy": "pnpm dlx wrangler deploy --env prod && pnpm dlx wrangler secret bulk .dev.vars.production",
		"deploy:dry-run": "pnpm dlx wrangler deploy --env prod --dry-run && cat .dev.vars.production",
		"dev": "wrangler dev",
		"test": "vitest run ",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"check": "biome check",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "biome format"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.971.0",
		"@aws-sdk/s3-request-presigner": "^3.971.0",
		"@hono/zod-validator": "^0.7.6",
		"@safe-fin/auth": "workspace:*",
		"@safe-fin/db": "workspace:*",
		"@safe-fin/utils": "workspace:*",
		"@sentry/cloudflare": "^10.38.0",
		"country-state-city": "^3.2.1",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.5",
		"neverthrow": "^8.2.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250715.0",
		"@types/bun": "latest",
		"@types/node": "^22.19.6",
		"miniflare": "^4.20250829.0",
		"supertest": "^7.1.4",
		"wrangler": "^4.24.3"
	}
}
