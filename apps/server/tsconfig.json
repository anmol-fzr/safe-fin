{
	"compilerOptions": {
		"target": "ESNext", // Use a modern target
		"module": "ESNext", // Set module system to ESNext
		"moduleResolution": "bundler", // *** CRITICAL FOR SPEED & PATHS ***
		"verbatimModuleSyntax": true,
		"strict": true,
		"composite": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@calulator/*": ["./src/modules/calculator/*"],
			"@lesson/*": ["./src/modules/lesson/*"],
			"@quiz/*": ["./src/modules/quiz/*"],
			"@address/*": ["./src/modules/address/*"],
			"@quiz-result/*": ["./src/modules/quiz-result/*"],
			"@/*": ["./src/*"]
		},
		// Your environment specific settings (e.g., for Hono/Workers)
		"types": [
			"bun",
			"@cloudflare/workers-types",
			"../../worker-configuration.d.ts"
		],
		"lib": ["ES2022"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"],
	"references": [
		{ "path": "../../packages/db" },
		{ "path": "../../packages/auth" }
	]
}
