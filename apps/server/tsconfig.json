{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"include": ["./src/**/*"],
		"paths": {
			"@calulator/*": ["./src/modules/calculator/*"],
			"@lesson/*": ["./src/modules/lesson/*"],
			"@quiz/*": ["./src/modules/quiz/*"],
			"@quiz-result/*": ["./src/modules/quiz-result/*"],
			"@/*": ["./src/*"]
		},
		"types": ["@cloudflare/workers-types", "../../worker-configuration.d.ts"],
		"lib": ["ESNext"]
	},
	"references": [
		{ "path": "../../packages/db" },
		{ "path": "../../packages/auth" }
	]
}
