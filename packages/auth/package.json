{
	"name": "@safe-fin/auth",
	"version": "0.0.0",
	"description": "Authentication package for Safe Fin",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts",
		"./app": "./src/app.ts",
		"./admin": "./src/admin.ts"
	},
	"scripts": {
		"auth:generate": "pnpm dlx @better-auth/cli generate --config ./src/better-auth.config.ts --output ../db/src/schema/auth-gen.ts"
	},
	"dependencies": {
		"@better-auth/expo": "catalog:",
		"@safe-fin/db": "workspace:*",
		"@simplewebauthn/browser": "^13.2.2",
		"better-auth": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"wrangler": "^4.24.3"
	}
}
